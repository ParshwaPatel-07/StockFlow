# Backend Production Environment Configuration Template
# For Render: Set these in the Render Dashboard -> Environment Variables

# Neon PostgreSQL connection string (include ?sslmode=require)
DATABASE_URL=postgresql://<user>:<password>@<neon-host>.neon.tech/stockflow?sslmode=require

# Allowed Frontend Origins (Comma-separated, no trailing slashes)
# Replace with your actual Render Static Site URL
CORS_ORIGINS=https://stockflow-frontend.onrender.com,http://localhost:5173

# Render automatically provides PORT at runtime (do not hardcode)
