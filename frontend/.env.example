# Frontend Production Environment Configuration Template
# For Render Static Site: Set these in Render Dashboard -> Environment Variables

# The public URL of your Render FastAPI backend (no trailing slash, no /api)
VITE_API_URL=https://stockflow-backend.onrender.com

# The public WebSocket URL of your Render FastAPI backend (no trailing slash)
# Note: If omitted, the frontend will automatically derive wss:// from VITE_API_URL
VITE_WS_URL=wss://stockflow-backend.onrender.com/ws
